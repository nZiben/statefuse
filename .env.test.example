# Copy to ".env.test" and fill in secrets.
STATEFUSE_OPENAI_API_KEY=provider-key-here
# Optional fallback for direct OpenAI usage:
# OPENAI_API_KEY=sk-your-key-here

# Optional overrides for real LLM demo / benchmark.
# This repo defaults best to a custom OpenAI-compatible /v1 endpoint.
STATEFUSE_OPENAI_BASE_URL=https://your-endpoint.example/v1
STATEFUSE_OPENAI_API_MODE=chat_completions

# If you are using direct OpenAI instead, comment the two lines above.

# You can still force one transport mode if needed:
# STATEFUSE_OPENAI_API_MODE=responses
# STATEFUSE_OPENAI_API_MODE=auto
# Optional network controls:
# STATEFUSE_OPENAI_TIMEOUT=20
# STATEFUSE_OPENAI_HARD_TIMEOUT=20
# STATEFUSE_OPENAI_MAX_RETRIES=0
# STATEFUSE_OPENAI_WORKERS=4
STATEFUSE_OPENAI_MODEL=gpt-4o-mini
STATEFUSE_OPENAI_TEMPERATURE=0
# STATEFUSE_OPENAI_SEED=42
